name: Home scheduled tick

on:
  workflow_dispatch:
  schedule:
    # UTC 16:00-22:00 = Asia/Shanghai 00:00-06:00
    # UTC 00/04/10/14 = Asia/Shanghai 08/12/18/22
    - cron: "0 0,4,10,14,16-22 * * *"

jobs:
  tick:
    runs-on: ubuntu-latest
    steps:
      - name: Wake home and run scheduled work
        env:
          HOME_URL: ${{ vars.HOME_URL }}
          CRON_SECRET: ${{ secrets.CRON_SECRET }}
        run: |
          test -n "$HOME_URL"
          test -n "$CRON_SECRET"
          curl --fail-with-body --retry 2 --retry-delay 15 \
            -X POST "${HOME_URL%/}/api/cron/tick" \
            -H "Authorization: Bearer ${CRON_SECRET}" \
            -H "Content-Type: application/json"
