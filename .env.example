# 应用本身
APP_SECRET=请替换为至少32位随机字符串
APP_PASSWORD=请设置访问这个家的密码
APP_TIMEZONE=Asia/Shanghai
START_DATE=2024-09-01
USER_NAME=断云去
AI_NAME=余天骋

# OpenAI 兼容聊天 API（密钥只能放服务端）
API_URL=https://你的接口地址
API_KEY=
API_MODEL=
SYSTEM_PROMPT=你是余天骋，正在与断云去自然地生活和聊天。

# Supabase（必须使用 server-side service_role / secret key，绝不能放进前端）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=home-attachments

# Ombre Brain：单独部署后填写其 MCP 地址
OMBRE_BRAIN_MCP_URL=
OMBRE_BRAIN_ACCESS_TOKEN=
OMBRE_BRAIN_ENABLED=false

# co-reading-mcp：推荐启动 src/server-sse.js（同时提供阅读器、REST 与 /mcp）
CO_READING_URL=
CO_READING_MCP_URL=
CO_READING_ACCESS_TOKEN=

# NAI / 生图（二选一：novelai 或 openai-compatible）
IMAGE_PROVIDER=
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
NAI_SAMPLER=k_euler_ancestral
NAI_STEPS=28
NAI_SCALE=5

# 天气位置（默认上海）
WEATHER_LATITUDE=31.2304
WEATHER_LONGITUDE=121.4737
WEATHER_LOCATION=上海

# 主动消息默认关闭，避免意外消耗 API 额度
PROACTIVE_ENABLED=false
PROACTIVE_MIN_IDLE_MINUTES=180

# 可选：外部定时器调用 /api/cron/tick 时使用
CRON_SECRET=
